{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "rootDir": "console",
    "outDir": "public/js",
    "strict": true,
    "noEmitOnError": true,
    "verbatimModuleSyntax": true
  },
  "include": ["console/**/*.ts"]
}
