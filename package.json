{
  "name": "nestcloud",
  "version": "1.0.0",
  "private": true,
  "description": "NestCloud 注册中心与配置中心",
  "license": "UNLICENSED",
  "scripts": {
    "docker:build": "docker buildx bake --allow=fs.read=.. --file docker-bake.hcl --load",
    "build": "pnpm run build:console && nest build",
    "build:console": "tsc -p tsconfig.console.json && node scripts/copy-console-assets.mts",
    "start": "pnpm run build:console && nest start",
    "start:dev": "pnpm run build:console && pnpm run \"/^watch:.*/\"",
    "watch:console": "tsc -p tsconfig.console.json --watch --preserveWatchOutput",
    "watch:server": "nest start --watch",
    "start:debug": "pnpm run build:console && pnpm run \"/^(watch:console|debug:server)$/\"",
    "debug:server": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "format": "oxfmt --write src console scripts",
    "lint": "oxlint src console scripts .husky/install.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "tsgo": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.console.json",
    "prepare": "node .husky/install.mts"
  },
  "dependencies": {
    "@nest-cloud/sdk": "file:../NestCloud-Sdk",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/serve-static": "^12.1.1",
    "@nestjs/typeorm": "^12.0.3",
    "@redis/client": "^6.3.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "js-yaml": "^5.5.0",
    "jsonc-parser": "3.3.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "^12.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "5.1.1",
    "bootstrap": "5.3.9",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "monaco-editor": "0.57.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "supertest": "^7.3.2",
    "typescript": "~6.0.3",
    "vitest": "5.1.1"
  },
  "lint-staged": {
    "{src/**/*.{ts,tsx,mts,cts},console/**/*.ts,scripts/**/*.mts,vitest.config.ts,.husky/*.mts}": [
      "oxfmt --write",
      "oxlint"
    ],
    "{*.json,*.md,docs/**/*.md}": "oxfmt --write"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
