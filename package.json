{
  "name": "nestcloud",
  "version": "0.0.1",
  "private": true,
  "description": "NestCloud 注册中心与配置中心",
  "license": "UNLICENSED",
  "scripts": {
    "build": "pnpm run build:console && nest build",
    "build:console": "tsc -p tsconfig.console.json && node scripts/copy-console-assets.mts",
    "start": "pnpm run build:console && nest start",
    "start:dev": "pnpm run build:console && pnpm run \"/^watch:.*/\"",
    "watch:console": "tsc -p tsconfig.console.json --watch --preserveWatchOutput",
    "watch:server": "nest start --watch",
    "start:debug": "pnpm run build:console && pnpm run \"/^(watch:console|debug:server)$/\"",
    "debug:server": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "format": "oxfmt --write src console scripts",
    "lint": "oxlint src console scripts .husky/install.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "tsgo": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.console.json",
    "prepare": "node .husky/install.mts"
  },
  "dependencies": {
    "@nest-cloud/sdk": "file:../NestCloud-Sdk",
    "@nestjs/common": "^11.1.23",
    "@nestjs/core": "^11.1.23",
    "@nestjs/platform-express": "^11.1.23",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/typeorm": "^11.0.1",
    "@redis/client": "^5.12.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "js-yaml": "^4.1.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.30"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.23",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.1",
    "@types/supertest": "^7.2.0",
    "@typescript/native-preview": "^7.0.0-dev.20260522.1",
    "@vitest/coverage-v8": "4.1.9",
    "bootstrap": "5.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "monaco-editor": "0.52.2",
    "oxfmt": "0.54.0",
    "oxlint": "1.69.0",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "vitest": "4.1.9"
  },
  "lint-staged": {
    "{src/**/*.{ts,tsx,mts,cts},console/**/*.ts,scripts/**/*.mts,vitest.config.ts,.husky/*.mts}": [
      "oxfmt --write",
      "oxlint"
    ],
    "{*.json,*.md,docs/**/*.md}": "oxfmt --write"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
}
