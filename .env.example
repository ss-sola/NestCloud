ServiceName=config-service
Port=3001
GlobalPrefix=api
# 启用鉴权时，在 NestCloud 与接入服务的本地部署配置中使用相同的随机 Token。
ControlPlaneToken=
DbDriver=postgres
DbHost=127.0.0.1
DbPort=5432
DbDatabase=nestcloud
DbUsername=postgres
DbPassword=
DbSynchronize=false
# 填入自定义的 Session 签名密钥。
SessionSecret=
# 注册记录和监控快照优先使用此 Redis。留空或连接中断时回退到进程内存。
RegistryRedisUrl=
# 服务监控使用独立共享签名密钥，至少 32 个字符。注册中心需同时配置 ControlPlaneToken。
ServiceMonitorToken=
# 主动采集周期，单位毫秒。取值 5000–300000。
ServiceMonitorIntervalMs=10000
# 可采集的注册实例主机名、IP 或 CIDR，多个用逗号分隔。
ServiceMonitorTrustedHosts=
# 可选，采集未注册实例，例如 gateway-service=http://127.0.0.1:3100。
ServiceMonitorStaticTargets=
