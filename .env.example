ServiceName=config-service
Port=3001
GlobalPrefix=api
# 启用鉴权时，在 NestCloud 与接入服务的本地部署配置中使用相同的随机 Token。
ControlPlaneToken=
DbDriver=postgres
DbHost=127.0.0.1
DbPort=5432
DbDatabase=nestcloud
DbUsername=postgres
DbPassword=
DbSynchronize=false
# 填入自定义的 Session 签名密钥。
SessionSecret=
# 留空时，注册记录存放在当前进程内存中。
RegistryRedisUrl=
